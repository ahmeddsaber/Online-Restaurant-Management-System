@page "/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Restuarant.Blazor.Models.Auth

@inject IAuthApiService AuthApi
@inject ILocalStorageService Storage

<PageTitle>@(_isRtl ? "الملف الشخصي - Gourmet Hub" : "Profile - Gourmet Hub")</PageTitle>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @_statusMessage
        <button type="button" class="btn-close" @onclick="() => _statusMessage = string.Empty"></button>
    </div>
}

<h4 class="fw-bold mb-4" style="color:#1a1a2e;">
    @(_isRtl ? "الملف الشخصي" : "My Profile")
</h4>

@if (_isLoading)
{
    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4" style="min-height: 280px;">
                <div class="card-body d-flex justify-content-center align-items-center">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-8">
            <div class="card border-0 shadow-sm rounded-4" style="min-height: 280px;">
                <div class="card-body d-flex justify-content-center align-items-center">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- PROFILE CARD -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-center h-100">
                <div class="card-body p-4">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width:88px; height:88px; font-size:2.5rem; font-weight:700;">
                        @(_user?.FirstName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                    </div>
                    <h5 class="fw-bold mb-1">
                        @(_user?.FullName ?? "—")
                    </h5>
                    <p class="text-muted small mb-3">
                        @(_user?.Email ?? "—")
                    </p>

                    <div class="d-flex flex-wrap justify-content-center gap-1 mb-4">
                        @foreach (var role in (_user?.Roles ?? new()))
                        {
                            <span class="badge border border-primary text-primary bg-light">
                                @role
                            </span>
                        }
                    </div>

                    <hr />

                    <div class="d-flex flex-column gap-2 text-start mt-3">
                        @if (!string.IsNullOrEmpty(_user?.PhoneNumber))
                        {
                            <div class="d-flex align-items-center text-muted">
                                <i class="bi bi-telephone me-2"></i>
                                <span class="small">@_user.PhoneNumber</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_user?.Address))
                        {
                            <div class="d-flex align-items-center text-muted">
                                <i class="bi bi-geo-alt me-2"></i>
                                <span class="small">@_user.Address</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- EDIT PROFILE -->
        <div class="col-12 col-md-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">
                        @(_isRtl ? "تعديل المعلومات" : "Edit Information")
                    </h5>

                    <EditForm Model="_profileModel" OnValidSubmit="UpdateProfile">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">@(_isRtl ? "الاسم الأول" : "First Name") <span class="text-danger">*</span></label>
                                <InputText @bind-Value="_profileModel.FirstName" class="form-control" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">@(_isRtl ? "اسم العائلة" : "Last Name") <span class="text-danger">*</span></label>
                                <InputText @bind-Value="_profileModel.LastName" class="form-control" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">@(_isRtl ? "رقم الهاتف" : "Phone Number")</label>
                                <InputText @bind-Value="_profileModel.PhoneNumber" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">@(_isRtl ? "العنوان" : "Address")</label>
                                <InputTextArea @bind-Value="_profileModel.Address" class="form-control" rows="2" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-4 fw-bold px-4" style="border-radius:10px; height:44px;">
                            @(_isRtl ? "حفظ التغييرات" : "Save Changes")
                        </button>
                    </EditForm>
                </div>
            </div>

            <!-- CHANGE PASSWORD -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">
                        @(_isRtl ? "تغيير كلمة المرور" : "Change Password")
                    </h5>

                    <EditForm Model="_pwdModel" OnValidSubmit="ChangePassword">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold small">@(_isRtl ? "كلمة المرور الحالية" : "Current Password")</label>
                                <InputText @bind-Value="_pwdModel.CurrentPassword" type="password" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">@(_isRtl ? "كلمة المرور الجديدة" : "New Password")</label>
                                <InputText @bind-Value="_pwdModel.NewPassword" type="password" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">@(_isRtl ? "تأكيد كلمة المرور" : "Confirm Password")</label>
                                <InputText @bind-Value="_pwdModel.ConfirmNewPassword" type="password" class="form-control" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-outline-warning mt-4 fw-bold px-4" style="border-radius:10px; height:44px;">
                            @(_isRtl ? "تغيير كلمة المرور" : "Change Password")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private UserInfo? _user;
    private UpdateProfileRequest _profileModel = new();
    private ChangePasswordRequest _pwdModel = new();
    private bool _isLoading = true;
    private bool _isRtl = false;

    private string _statusMessage = "";
    private bool _isError = false;

    protected override async Task OnInitializedAsync()
    {
        var c = await Storage.GetItemAsync("culture");
        _isRtl = c == "ar";

        try {
            var result = await AuthApi.GetCurrentUserAsync();
            _user = result?.Data;

            if (_user != null)
            {
                _profileModel = new UpdateProfileRequest
                {
                    FirstName = _user.FirstName,
                    LastName = _user.LastName,
                    PhoneNumber = _user.PhoneNumber,
                    Address = _user.Address
                };
            }
        } catch {}

        _isLoading = false;
    }

    void UpdateProfile()
    {
        // Call API: PUT /api/Auth/profile
        ShowMessage(_isRtl ? "تم حفظ التغييرات" : "Profile updated!", false);
    }

    void ChangePassword()
    {
        if (_pwdModel.NewPassword != _pwdModel.ConfirmNewPassword)
        {
            ShowMessage(_isRtl ? "كلمتا المرور غير متطابقتين" : "Passwords don't match", true);
            return;
        }
        // Call API: POST /api/Auth/change-password
        ShowMessage(_isRtl ? "تم تغيير كلمة المرور" : "Password changed!", false);
        _pwdModel = new();
    }

    private async void ShowMessage(string msg, bool isError)
    {
        _statusMessage = msg;
        _isError = isError;
        StateHasChanged();
        await Task.Delay(3000);
        _statusMessage = "";
        StateHasChanged();
    }
}
