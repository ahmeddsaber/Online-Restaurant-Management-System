@page "/register"
@layout AuthLayout
@using Restuarant.Blazor.Models.Auth
@inject IAuthApiService AuthApi
@inject NavigationManager NavManager
@inject ILocalStorageService Storage

<PageTitle>@(_isRtl ? "إنشاء حساب - Gourmet Hub" : "Register - Gourmet Hub")</PageTitle>

<div class="register-wrapper">
    <div class="register-card">
        <div class="text-center mb-4">
            <i class="bi bi-shop text-warning" style="font-size:3rem;"></i>
            <h5 class="fw-bold mt-2">
                @(_isRtl ? "إنشاء حساب جديد" : "Create Account")
            </h5>
            <p class="text-muted">
                @(_isRtl ? "انضم إلى Gourmet Hub اليوم" : "Join Gourmet Hub today")
            </p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4 py-2" role="alert">
                <small>@_errorMessage</small>
                <button type="button" class="btn-close" style="padding: 0.8rem;" @onclick="() => _errorMessage = string.Empty"></button>
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label fw-bold small">@(_isRtl ? "الاسم الأول" : "First Name") <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_model.FirstName" class="form-control" required />
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-bold small">@(_isRtl ? "اسم العائلة" : "Last Name") <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_model.LastName" class="form-control" required />
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold small">@(_isRtl ? "البريد الإلكتروني" : "Email") <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                        <InputText @bind-Value="_model.Email" type="email" class="form-control" required />
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold small">@(_isRtl ? "رقم الهاتف" : "Phone Number")</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-telephone"></i></span>
                        <InputText @bind-Value="_model.PhoneNumber" class="form-control" />
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold small">@(_isRtl ? "كلمة المرور" : "Password") <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                        <InputText @bind-Value="_model.Password" type="@(_showPwd ? "text" : "password")" class="form-control" required />
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => _showPwd = !_showPwd">
                            <i class="bi @(_showPwd ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold small">@(_isRtl ? "تأكيد كلمة المرور" : "Confirm Password") <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock-fill"></i></span>
                        <InputText @bind-Value="_model.ConfirmPassword" type="password" class="form-control" required />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4 register-btn" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                @(_isRtl ? "إنشاء الحساب" : "Create Account")
            </button>
        </EditForm>

        <div class="text-center mt-3">
            <small class="text-muted">
                @(_isRtl ? "لديك حساب بالفعل؟" : "Already have an account?")
                <a href="/login" class="text-primary fw-bold text-decoration-none ms-1">
                    @(_isRtl ? "تسجيل الدخول" : "Sign In")
                </a>
            </small>
        </div>
    </div>
</div>

<style>
    .register-wrapper {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 24px;
    }

    .register-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        animation: slideUp 0.4s ease;
    }

    .register-btn {
        height: 48px;
        font-weight: 700;
        font-size: 1rem;
        border-radius: 10px;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private RegisterRequest _model = new();
    private bool _isLoading = false;
    private bool _showPwd = false;
    private bool _isRtl = false;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var c = await Storage.GetItemAsync("culture");
        _isRtl = c == "ar";
    }

    async Task HandleRegister()
    {
        if (_model.Password != _model.ConfirmPassword)
        {
            _errorMessage = _isRtl ? "كلمتا المرور غير متطابقتين" : "Passwords do not match";
            return;
        }

        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            var result = await AuthApi.RegisterAsync(_model);
            if (result?.Success == true)
            {
                NavManager.NavigateTo("/login");
            }
            else
            {
                _errorMessage = result?.Message ?? "Registration failed";
            }
        }
        catch
        {
            _errorMessage = _isRtl ? "حدث خطأ، حاول مجدداً" : "An error occurred";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
