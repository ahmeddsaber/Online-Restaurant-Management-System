@page "/404"
@layout AuthLayout

<div class="not-found-wrapper">
    <div class="not-found-content">
        <div class="not-found-code">404</div>
        <i class="bi bi-search text-danger mb-3" style="font-size:5rem;"></i>
        <h4 class="fw-bold mb-2" style="color:#1a1a2e;">
            Page Not Found
        </h4>
        <p class="text-muted mb-4 text-center" style="max-width:400px;">
            The page you're looking for doesn't exist or has been moved.
        </p>
        <a href="/" class="btn btn-primary fw-bold px-4" style="border-radius:10px; height:46px; line-height:33px;">
            <i class="bi bi-house-door me-2"></i> Back to Dashboard
        </a>
    </div>
</div>

<style>
    .not-found-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 24px;
    }

    .not-found-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: fadeIn 0.6s ease;
    }

    .not-found-code {
        font-size: 8rem;
        font-weight: 900;
        line-height: 1;
        background: linear-gradient(135deg, #e63946, #c1121f);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 8px;
        letter-spacing: -4px;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
