@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Restuarant.Blazor.Models.Dashboard
@inject IDashboardApiService DashboardApi
@inject ILocalStorageService Storage

<PageTitle>@(_isRtl ? "لوحة التحكم - Gourmet Hub" : "Dashboard - Gourmet Hub")</PageTitle>

<!-- PAGE HEADER -->
<div class="mb-4">
    <h4 class="fw-bold" style="color:#1a1a2e;">
        @(_isRtl ? "لوحة التحكم" : "Dashboard")
    </h4>
    <p class="text-muted mb-0">
        @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
    </p>
</div>

@if (_isLoading)
{
    <div class="row g-4">
        @for (int i = 0; i < 4; i++)
        {
            <div class="col-12 col-sm-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4" style="height:120px;">
                    <div class="card-body">
                        <div class="placeholder-glow">
                            <span class="placeholder col-12 bg-secondary rounded py-2 mb-2"></span>
                            <span class="placeholder col-8 bg-secondary rounded py-3"></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- STAT CARDS -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="stat-card stat-card--primary">
                <div class="stat-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="stat-body flex-grow-1">
                    <small class="stat-label">@(_isRtl ? "إجمالي الطلبات" : "Total Orders")</small>
                    <h4 class="stat-value mb-1">@(_dashboard?.TotalOrders ?? 0)</h4>
                    <small class="stat-sub">
                        <i class="bi bi-graph-up-arrow me-1"></i>
                        @(_isRtl ? "اليوم: " : "Today: ")@(_dashboard?.TodayOrders ?? 0)
                    </small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="stat-card stat-card--success">
                <div class="stat-icon">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div class="stat-body flex-grow-1">
                    <small class="stat-label">@(_isRtl ? "إجمالي الإيرادات" : "Total Revenue")</small>
                    <h4 class="stat-value mb-1">$@((_dashboard?.TotalRevenue ?? 0).ToString("N0"))</h4>
                    <small class="stat-sub">@(_isRtl ? "اليوم: $" : "Today: $")@((_dashboard?.TodayRevenue ?? 0).ToString("N0"))</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="stat-card stat-card--warning">
                <div class="stat-icon">
                    <i class="bi bi-card-list"></i>
                </div>
                <div class="stat-body flex-grow-1">
                    <small class="stat-label">@(_isRtl ? "أصناف القائمة" : "Menu Items")</small>
                    <h4 class="stat-value mb-1">@(_dashboard?.TotalMenuItems ?? 0)</h4>
                    <small class="stat-sub">@(_isRtl ? "طاولات نشطة: " : "Active Tables: ")@(_dashboard?.ActiveTables ?? 0)</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="stat-card stat-card--info">
                <div class="stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-body flex-grow-1">
                    <small class="stat-label">@(_isRtl ? "العملاء" : "Customers")</small>
                    <h4 class="stat-value mb-1">@(_dashboard?.TotalCustomers ?? 0)</h4>
                    <small class="stat-sub">@(_isRtl ? "إجمالي المستخدمين: " : "Total Users: ")@(_dashboard?.TotalUsers ?? 0)</small>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN BODY -->
    <div class="row g-4 mb-4">
        <!-- ORDER STATUS -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-4">@(_isRtl ? "حالة الطلبات" : "Orders by Status")</h6>
                    @if (_dashboard?.OrdersByStatus?.Any() == true)
                    {
                        @foreach (var s in _dashboard.OrdersByStatus)
                        {
                            var bClass = s.Status switch {
                                "Pending" => "bg-warning",
                                "Preparing" => "bg-primary",
                                "Ready" => "bg-success",
                                "Delivered" => "bg-info",
                                "Cancelled" => "bg-danger",
                                _ => "bg-secondary"
                            };
                            var pct = _dashboard.TotalOrders > 0
                                ? (int)((double)s.Count / _dashboard.TotalOrders * 100)
                                : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="fw-semibold">@s.Status</small>
                                    <small class="fw-bold">@s.Count</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @bClass" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-bar-chart fs-1 mb-2"></i>
                            <p class="mb-0 small">@(_isRtl ? "لا توجد بيانات" : "No data available")</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-4">@(_isRtl ? "الإجراءات السريعة" : "Quick Actions")</h6>
                    <div class="d-grid gap-3">
                        <a href="/menu/items" class="btn btn-outline-primary text-start px-3 rounded-3">
                            <i class="bi bi-plus-lg me-2"></i> @(_isRtl ? "إضافة صنف جديد" : "Add Menu Item")
                        </a>
                        <a href="/orders" class="btn btn-outline-success text-start px-3 rounded-3">
                            <i class="bi bi-receipt me-2"></i> @(_isRtl ? "عرض الطلبات" : "View Orders")
                        </a>
                        <a href="/users" class="btn btn-outline-warning text-start px-3 rounded-3">
                            <i class="bi bi-person-plus me-2"></i> @(_isRtl ? "إضافة مستخدم" : "Add User")
                        </a>
                        <a href="/menu/categories" class="btn btn-outline-info text-start px-3 rounded-3">
                            <i class="bi bi-folder me-2"></i> @(_isRtl ? "إدارة الفئات" : "Manage Categories")
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- SYSTEM INFO -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background:linear-gradient(135deg,#1a1a2e,#0f3460); color:white;">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-white mb-4">@(_isRtl ? "حالة النظام" : "System Status")</h6>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                        <span class="mb-0 flex-grow-1" style="color:rgba(255,255,255,0.85);">API Connected</span>
                        <span class="badge bg-success rounded-pill">Online</span>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                        <span class="mb-0 flex-grow-1" style="color:rgba(255,255,255,0.85);">Database</span>
                        <span class="badge bg-success rounded-pill">Healthy</span>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-credit-card-fill text-warning fs-5 me-2"></i>
                        <span class="mb-0 flex-grow-1" style="color:rgba(255,255,255,0.85);">Stripe Payments</span>
                        <span class="badge bg-warning rounded-pill text-dark">Active</span>
                    </div>
                    <hr style="border-color:rgba(255,255,255,0.2);" />
                    <small style="color:rgba(255,255,255,0.5);">
                        @(_isRtl ? "آخر تحديث: " : "Last updated: ")@DateTime.Now.ToShortTimeString()
                    </small>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .stat-card {
        border-radius: 16px;
        padding: 24px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }

    .stat-card--primary { background: linear-gradient(135deg, #e63946, #c1121f); color: white; }
    .stat-card--success { background: linear-gradient(135deg, #2ec4b6, #0d9488); color: white; }
    .stat-card--warning { background: linear-gradient(135deg, #f4a261, #e76f51); color: white; }
    .stat-card--info    { background: linear-gradient(135deg, #457b9d, #1d3557); color: white; }

    .stat-icon {
        background: rgba(255,255,255,0.2);
        border-radius: 12px;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.5rem;
    }

    .stat-label { color: rgba(255,255,255,0.8); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; display:block; }
    .stat-value { color: white; font-weight: 800; line-height: 1.2; }
    .stat-sub { color: rgba(255,255,255,0.75); display: flex; align-items: center; gap: 4px; margin-top: 4px; }
</style>

@code {
    private AdminDashboardDto? _dashboard;
    private bool _isLoading = true;
    private bool _isRtl = false;

    protected override async Task OnInitializedAsync()
    {
        var culture = await Storage.GetItemAsync("culture");
        _isRtl = culture == "ar";
        _dashboard = await DashboardApi.GetAdminDashboardAsync();
        _isLoading = false;
    }
}
